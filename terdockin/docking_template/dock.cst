#1 – D404 protonates terminal olefin at C3 (Gaussian C5 = Y00 C10)
# Y00 C10 = Gaussian C5  = Conventional C3 (CH2, D404 protonation target)
# Y00 C7  = Gaussian ??  = Conventional C4 (gem-dimethyl quaternary, angle partner)
# Y00 C2  = Gaussian C25 = Conventional C8 (carbocation center)
CST::BEGIN
  TEMPLATE::   ATOM_MAP: 1 atom_name: C10 C7  C9
  TEMPLATE::   ATOM_MAP: 1 residue3:  Y00

  TEMPLATE::   ATOM_MAP: 2 atom_name: OD2 CG  CB
  TEMPLATE::   ATOM_MAP: 2 residue1:  D

  CONSTRAINT:: distanceAB:   2.5  0.5  500  0    3
  CONSTRAINT::    angle_A:  109.0 10.0  50  360.  2
  CONSTRAINT::    angle_B:  120.0 10.0  50  360.  2
CST::END

#2 – N451 H-bonds OD1 of D404, activating D404 as catalytic acid
# AgAS N451 (Table S2 uses N342 for a different enzyme; N451 confirmed in main paper for AgAS)
CST::BEGIN
  TEMPLATE::   ATOM_MAP: 1 atom_name: ND2 CG  CB
  TEMPLATE::   ATOM_MAP: 1 residue1:  N

  TEMPLATE::   ATOM_MAP: 2 atom_name: OD1 CG  CB
  TEMPLATE::   ATOM_MAP: 2 residue1:  D

  CONSTRAINT:: distanceAB:   2.7  0.3  500  0    3
  CONSTRAINT::    angle_A:  113.0 10.0  50  360.  2
  CONSTRAINT::    angle_B:  131.2 10.0  50  360.  2
CST::END

#3 – H348 ND1 H-bonds OH of Y287 (Tyr-His dyad, positions Y287 as catalytic base)
# Table S2: ND1(H348)-OH(Y287) 3.1 Å; ND1-CE1(H348)-OH angle 113.0°; ND1-OH-CZ angle 123.2°
CST::BEGIN
  TEMPLATE::   ATOM_MAP: 1 atom_name: ND1 CE1 CD2
  TEMPLATE::   ATOM_MAP: 1 residue1:  H

  TEMPLATE::   ATOM_MAP: 2 atom_name: OH  CZ  CE1
  TEMPLATE::   ATOM_MAP: 2 residue1:  Y

  CONSTRAINT:: distanceAB:   3.1  0.3  500  0    3
  CONSTRAINT::    angle_A:  113.0 10.0  50  360.  2
  CONSTRAINT::    angle_B:  123.2 10.0  50  360.  2
CST::END

#4 – Y287 OH acts as catalytic base, deprotonating C17 (Gaussian C27 = Y00 C11)
# Y00 C11 = Gaussian C27 = Conventional C17 (CH3 truncated from exo =CH2, on carbocation C8)
# Y00 C2  = Gaussian C25 = Conventional C8  (carbocation center)
# Table S3: C27-OH 3.0 Å; C27-C25-OH angle 110.96°; C27-OH-CZ angle 115.89°
CST::BEGIN
  TEMPLATE::   ATOM_MAP: 1 atom_name: OH  CZ  CE1
  TEMPLATE::   ATOM_MAP: 1 residue1:  Y

  TEMPLATE::   ATOM_MAP: 2 atom_name: C11 C2  C8
  TEMPLATE::   ATOM_MAP: 2 residue3:  Y00

  CONSTRAINT:: distanceAB:   3.0  0.5  500  0    3
  CONSTRAINT::    angle_A:  115.89 10.0  50  360.  2
  CONSTRAINT::    angle_B:  110.96 10.0  50  360.  2
CST::END
